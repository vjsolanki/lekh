---
/**
 * The head of a page: where you are, then what this is.
 *
 * Starlight's own title is the title alone, which leaves the reader to work out
 * which part of the build they have landed in from the sidebar. The eyebrow
 * says it outright, in a small mono label, and it is read off the same sidebar
 * so it can never disagree with the navigation.
 *
 * Overrides `@astrojs/starlight/components/PageTitle.astro`.
 */
import type { StarlightRouteData } from "@astrojs/starlight/route-data";

type Entry = StarlightRouteData["sidebar"][number];

/** Every link under an entry, however deeply nested. */
function links(entry: Entry): Extract<Entry, { type: "link" }>[] {
  return entry.type === "link" ? [entry] : entry.entries.flatMap(links);
}

const { sidebar, entry } = Astro.locals.starlightRoute;

// The group holding the current page. A page can sit at the top level with no
// group at all — the glossary does — in which case there is nothing to say.
const section = sidebar.find(
  (item) => item.type === "group" && links(item).some((link) => link.isCurrent),
)?.label;
---

<div class="page-head">
  {section && <p class="docs-slug">{section}</p>}
  <h1 id="_top">{entry.data.title}</h1>
</div>

<style>
  .page-head {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  /* Geist at 600, set tight like the landing page's titles. */
  h1 {
    font-family: var(--docs-font-display);
    font-size: var(--sl-text-h1);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.04em;
    color: var(--sl-color-white);
    text-wrap: balance;
  }
</style>
