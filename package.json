{
  "name": "lekh-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "docs:dev": "pnpm --filter @lekh/docs dev",
    "build": "pnpm -r build",
    "size": "pnpm --filter lekh-editor size",
    "typecheck": "pnpm -r typecheck && tsc -p lint",
    "test": "pnpm -r test",
    "lint": "oxlint",
    "lint:types": "oxlint --type-aware",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxlint": "^1.77.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.122.0"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx,yml,yaml,astro,css}": [
      "prettier --write"
    ]
  }
}
